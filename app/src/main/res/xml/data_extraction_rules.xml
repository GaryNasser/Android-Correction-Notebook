<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="bit_student_credential.xml" />
        <exclude domain="sharedpref" path="ai_secret_key_store.xml" />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/ai_settings.preferences_pb" />
        <exclude domain="database" path="ai.db" />
        <exclude domain="database" path="ai.db-shm" />
        <exclude domain="database" path="ai.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bit_student_credential.xml" />
        <exclude domain="sharedpref" path="ai_secret_key_store.xml" />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/ai_settings.preferences_pb" />
        <exclude domain="database" path="ai.db" />
        <exclude domain="database" path="ai.db-shm" />
        <exclude domain="database" path="ai.db-wal" />
    </device-transfer>
</data-extraction-rules>
