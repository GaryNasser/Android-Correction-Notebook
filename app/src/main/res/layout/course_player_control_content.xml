<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="8dp"
    android:background="@android:color/black"
    android:layoutDirection="ltr"
    android:orientation="vertical">
    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:played_color="@android:color/white"
        app:scrubber_color="@android:color/white"
        app:buffered_color="#808080"
        app:unplayed_color="#404040" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@id/exo_rew"
            style="@style/ExoStyledControls.Button.Center"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/exo_styled_controls_rewind"
            android:contentDescription="@string/exo_controls_rewind_description" />
        <ImageButton android:id="@id/exo_play_pause"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:layout_width="48dp" android:layout_height="48dp" />
        <ImageButton android:id="@id/exo_ffwd"
            style="@style/ExoStyledControls.Button.Center"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/exo_styled_controls_fastforward"
            android:contentDescription="@string/exo_controls_fastforward_description" />
        <TextView android:id="@id/exo_position" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@android:color/white"
            android:textSize="11sp" android:importantForAccessibility="yes" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text=" / " android:textColor="@android:color/white" android:textSize="11sp" />
        <TextView android:id="@id/exo_duration" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="11sp" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@id/exo_settings"
            style="@style/ExoStyledControls.Button.Bottom.Settings"
            android:layout_width="48dp" android:layout_height="48dp" />
    </LinearLayout>
</LinearLayout>
