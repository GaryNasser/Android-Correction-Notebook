# --- Build 产物 (编译生成的临时文件，最占空间且不需要上传) ---
build/
*/build/
bin/
gen/
out/
.gradle/
.kotlin/

# --- IDE 配置文件 (Android Studio / IntelliJ) ---
# 整个 .idea/ 目录都含本地路径、窗口布局与缓存，一律忽略。
# 早先逐个列文件名（workspace.xml、gradle.xml……）会漏掉新生成的配置文件。
.idea/
*.iml
*.iws
*.ipr

# --- 本地配置文件 (绝对不能上传，包含你的 SDK 路径或密钥) ---
local.properties
.navigation/

# --- 签名文件 (私钥，千万不要上传到 GitHub！) ---
*.jks
*.keystore
*.p12
*.key
*.pub

# --- 测试与捕获 ---
captures/
.externalNativeBuild/
.cxx/
cmake-build-*/

# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db

# --- 日志文件 ---
*.log

.claude/
.superpowers/
spring-correction-book-master/

docs/
